# Accounts and suggestions (optional).
#
# Without these the site works exactly as before: everyone browses as a guest,
# prayer times still come from src/data/masjids.json, and the suggestion UI
# explains that accounts aren't set up. Set them in Vercel → Settings →
# Environment Variables to turn accounts on.
#
# Both are safe to expose in the browser — the anon key is public by design and
# the database's row-level security is what actually enforces the roles.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Map (optional).
#
# Without this the Map tab explains it isn't set up yet, and every other page
# is unaffected — prayer times never depend on the map. Restrict the key to
# the Maps JavaScript API and to your site's domain(s) in Google Cloud
# Console, since it ships in the client bundle and is publicly visible.
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
