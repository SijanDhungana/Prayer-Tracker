{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for Playwright's page.$$eval callbacks, which are compiled as
    // part of this project but execute inside the browser.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "scrape.ts"]
}
