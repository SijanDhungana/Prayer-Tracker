{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is here for Playwright's page.$$eval callbacks, which are compiled as
    // part of this project but execute inside the browser.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // "vite/client" alongside node because the check:* scripts exercise real
    // app modules, and some of those read import.meta.env (supabase.ts,
    // googleMaps.ts). Without it, a test that imports one of them fails to
    // compile here even though the same file compiles fine in the app project,
    // which would push those modules out of test coverage for the wrong reason.
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "scrape.ts", "scripts/**/*.ts"]
}
